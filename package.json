{
    "name": "zoho-crm-sidekick",
    "displayName": "SideKick for Zoho CRM",
    "version": "0.2.0",
    "description": "Side panel for Zoho CRM admins: metadata browser, record viewer and setup navigation. Not affiliated with Zoho Corporation.",
    "author": "frauhottelmann (based on PowerCRM SideKick 365 by Sofiane GUEZZAR)",
    "scripts": {
        "dev": "plasmo dev",
        "build": "pnpm run build:chrome && pnpm run build:firefox",
        "build:chrome": "plasmo build --target=chrome-mv3",
        "build:firefox": "plasmo build --target=firefox-mv3",
        "package": "pnpm run package:chrome && pnpm run package:firefox",
        "package:chrome": "plasmo package --target=chrome-mv3",
        "package:firefox": "plasmo package --target=firefox-mv3",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint src",
        "lint:chrome": "node scripts/check-chrome-manifest.mjs",
        "update:chrome-schema": "node -e \"fetch('https://json.schemastore.org/chrome-manifest.json').then(r=>r.text()).then(t=>require('fs').writeFileSync('scripts/schemas/chrome-manifest.schema.json',t))\"",
        "format": "prettier --write src",
        "format:check": "prettier --check src"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@hello-pangea/dnd": "^18.0.1",
        "@mui/icons-material": "^7.3.4",
        "@mui/material": "^7.3.4",
        "@mui/x-data-grid": "^9.17.0",
        "@uiw/react-json-view": "2.0.0-alpha.44",
        "notistack": "^3.0.2",
        "plasmo": "0.90.5",
        "react": "18.2.0",
        "react-dom": "18.2.0"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "@mui/types": "^9.5.0",
        "@plasmohq/parcel-resolver": "^0.14.2",
        "@types/chrome": "0.3.7",
        "@types/node": "26.6.6",
        "@types/react": "18.2.48",
        "@types/react-dom": "18.2.18",
        "ajv": "^8.20.0",
        "oxlint": "^1.92.0",
        "prettier": "3.9.10",
        "typescript": "7.0.2"
    },
    "manifest": {
        "host_permissions": [
            "https://crm.zoho.com/*",
            "https://crm.zoho.eu/*",
            "https://crm.zoho.in/*",
            "https://crm.zoho.com.au/*",
            "https://crm.zoho.jp/*",
            "https://crm.zoho.com.cn/*",
            "https://crm.zoho.sa/*",
            "https://crm.zohocloud.ca/*",
            "https://crmsandbox.zoho.com/*",
            "https://crmsandbox.zoho.eu/*",
            "https://crmsandbox.zoho.in/*",
            "https://crmsandbox.zoho.com.au/*",
            "https://crmsandbox.zoho.jp/*",
            "https://crmsandbox.zoho.com.cn/*",
            "https://crmsandbox.zoho.sa/*",
            "https://crmsandbox.zohocloud.ca/*"
        ],
        "permissions": [
            "storage"
        ],
        "browser_specific_settings": {
            "gecko": {
                "id": "zoho-crm-sidekick@frauhottelmann.github.io",
                "data_collection_permissions": {
                    "required": [
                        "none"
                    ]
                }
            }
        }
    },
    "pnpm": {
        "overrides": {
            "glob": "^10.5.0"
        }
    }
}
